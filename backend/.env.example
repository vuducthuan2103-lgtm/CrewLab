DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/crewlab
SUPABASE_POOLER_MODE=session
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1
DB_POOL_TIMEOUT_SECONDS=15
DB_POOL_RECYCLE_SECONDS=300
